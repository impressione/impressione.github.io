---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Falha no envio | impressione.me"
  description="Não foi possível enviar sua mensagem agora."
  path="/contato/falha"
>
  <main>
    <section class="inner-hero">
      <div class="container contact-hero">
        <div class="feature-card contact-form-card contact-form-hero">
          <div class="section-heading compact form-heading">
            <p class="kicker">Tente novamente</p>
            <h1>Não foi possível enviar sua mensagem agora.</h1>
            <p>
              Tente novamente em alguns instantes. Se preferir, escreva diretamente para
              <a href="mailto:contato@impressione.me"> contato@impressione.me</a>.
            </p>
          </div>

          <div class="form-actions">
            <a href="/contato" class="button button-primary">Voltar ao formulário</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
