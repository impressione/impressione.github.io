---
import SiteLayout from "../layouts/SiteLayout.astro";

const interestOptions = [
  "Novo produto ou sistema",
  "IA aplicada e automação",
  "Arquitetura e reestruturação técnica",
  "DevOps, deploy e observabilidade",
];
---

<SiteLayout
  title="Contato | impressione.me"
  description="Converse com a impressione.me sobre software sob medida, IA aplicada, automação e operação contínua."
  path="/contato"
>
  <main>
    <section class="inner-hero">
      <div class="container contact-hero">
        <div class="section-heading compact contact-intro">
          <p class="kicker">Contato</p>
          <h1>Vamos conversar sobre o seu próximo desafio.</h1>
          <p>
            Conte o que você quer construir, evoluir ou simplificar. Para começar, basta deixar seu e-mail.
          </p>
        </div>

        <form
          class="feature-card contact-form-card contact-form-hero"
          method="post"
          action="/api/contact"
        >
          <div class="section-heading compact form-heading">
            <p class="kicker">Formulário de contato</p>
            <h2>Deixe seu contato e continuamos a conversa.</h2>
            <p>
              O e-mail é o único campo obrigatório. Se quiser, compartilhe um pouco de contexto para que possamos responder de forma mais útil.
            </p>
          </div>

          <div class="form-grid">
            <label class="field">
              <span>E-mail</span>
              <input type="email" name="email" autocomplete="email" placeholder="voce@empresa.com" required />
            </label>

            <label class="field">
              <span>Nome</span>
              <input type="text" name="name" autocomplete="name" placeholder="Como você se chama?" />
            </label>

            <label class="field">
              <span>Empresa</span>
              <input type="text" name="company" autocomplete="organization" placeholder="Nome da empresa" />
            </label>

            <label class="field">
              <span>Interesse principal</span>
              <select name="interest">
                <option value="">Selecione se quiser</option>
                {interestOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </label>

            <label class="field field-full">
              <span>Mensagem</span>
              <textarea
                name="message"
                rows="5"
                placeholder="Se quiser, conte rapidamente sobre o projeto, momento atual ou objetivo."
              ></textarea>
            </label>

            <label class="field field-hidden" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="button button-primary">Enviar mensagem</button>
          </div>
        </form>
      </div>
    </section>

    <section class="section">
      <div class="container contact-layout">
        <aside class="contact-card">
          <p class="contact-label">Contato direto</p>
          <a href="mailto:contato@impressione.me" class="contact-email">contato@impressione.me</a>
          <p class="contact-copy">
            Se preferir, escreva diretamente por e-mail. O formulário também ajuda a compartilhar o contexto inicial do projeto.
          </p>
        </aside>

        <div class="feature-card emphasis">
          <p class="kicker">Como normalmente ajudamos</p>
          <p class="contact-copy">
            Atuamos em software sob medida, IA aplicada, automação e práticas de entrega contínua.
          </p>
          <div class="topic-list">
            {interestOptions.map((topic) => (
              <span class="topic-item">{topic}</span>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
