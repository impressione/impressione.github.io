---
import SiteLayout from "../layouts/SiteLayout.astro";

const services = [
  {
    title: "Produto, IA e arquitetura",
    description:
      "Transformamos objetivos de negócio em produtos claros, sustentáveis e prontos para evoluir — com IA aplicada onde ela gera valor.",
  },
  {
    title: "Desenvolvimento e automação inteligente",
    description:
      "Construímos aplicações, integrações e automações com apoio de IA para acelerar a entrega, manter o contexto e reduzir trabalho repetitivo.",
  },
  {
    title: "Qualidade e operação contínua",
    description:
      "Estruturamos testes, publicação contínua e monitoramento para reduzir riscos e tornar cada entrega mais previsível.",
  },
];

const stages = [
  "Descoberta técnica e definição do escopo",
  "Arquitetura, desenho da solução e definição dos pontos em que a IA pode ajudar",
  "Desenvolvimento, automação, testes e revisão contínua",
  "Publicação, hospedagem, monitoramento e evolução do produto",
];

const stack = [
  "Aplicações web modernas",
  "APIs e integrações",
  "Aplicações web e produtos digitais",
  "APIs e integrações",
  "IA aplicada ao produto",
  "Automação de processos",
  "Entrega contínua e infraestrutura em nuvem",
  "Monitoramento, testes e qualidade",
];
---

<SiteLayout
  title="impressione.me | Software sob medida e IA aplicada"
  description="Criamos e evoluímos produtos digitais com software sob medida, IA aplicada, automação, qualidade e operação contínua."
  path="/"
>
  <main>
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="kicker">Software, IA e operação em sintonia</p>
          <h1>Software confiável para transformar ideias e operações complexas em resultado.</h1>
          <p class="lead">
            Da estratégia à operação contínua, criamos produtos digitais que resolvem problemas reais. Combinamos arquitetura, desenvolvimento, qualidade e IA aplicada para entregar com mais clareza, velocidade e previsibilidade.
          </p>

          <div class="hero-actions">
            <a href="/contato" class="button button-primary">Falar sobre meu projeto</a>
            <a href="#servicos" class="button button-secondary">Conhecer como atuamos</a>
          </div>
        </div>

        <div class="hero-panel" aria-label="Resumo da atuação da impressione.me">
          <div class="hero-card hero-card-large">
            <p class="card-label">Do plano à evolução</p>
            <p class="card-value">Entendemos o desafio, construímos a solução e cuidamos da sua evolução.</p>
          </div>

          <div class="hero-card-grid">
            <div class="hero-card">
              <p class="card-label">IA aplicada</p>
              <p class="card-value">Uso prático para melhorar produto, processos e decisões.</p>
            </div>
            <div class="hero-card">
              <p class="card-label">Automação</p>
              <p class="card-value">Fluxos inteligentes com supervisão e contexto.</p>
            </div>
            <div class="hero-card">
              <p class="card-label">Operação</p>
              <p class="card-value">Publicação, infraestrutura e acompanhamento contínuo.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container stat-band">
        <div>
          <p class="stat-value">Produto, engenharia e IA</p>
          <p class="stat-copy">Decisões técnicas conectadas ao que o negócio precisa alcançar.</p>
        </div>
        <div>
          <p class="stat-value">Automação que faz sentido</p>
          <p class="stat-copy">IA e automação entram onde simplificam o trabalho e aumentam a qualidade.</p>
        </div>
        <div>
          <p class="stat-value">Operação preparada para crescer</p>
          <p class="stat-copy">Entrega contínua, infraestrutura e monitoramento com menos retrabalho e mais segurança.</p>
        </div>
      </div>
    </section>

    <section id="servicos" class="section">
      <div class="container">
        <div class="section-heading">
          <p class="kicker">Serviços</p>
          <h2>Do primeiro desenho à operação contínua, criamos software que sustenta o crescimento do seu negócio.</h2>
          <p>
            Trabalhamos lado a lado com empresas que precisam transformar desafios em produtos estáveis, úteis e fáceis de evoluir.
          </p>
        </div>

        <div class="card-grid three-up">
          {services.map((service) => (
            <article class="feature-card">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="esteira" class="section section-accent">
      <div class="container process-grid">
        <div class="section-heading compact">
          <p class="kicker">Esteira de entrega</p>
          <h2>Do planejamento à operação, conectamos pessoas, processos e tecnologia para reduzir atritos na entrega.</h2>
          <p>
            Organizamos a jornada técnica para que decisões, código, infraestrutura e qualidade avancem na mesma direção.
          </p>
        </div>

        <ol class="timeline">
          {stages.map((stage, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{stage}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="stack" class="section">
      <div class="container stack-grid">
        <div class="section-heading compact">
          <p class="kicker">Tecnologia, IA e operação</p>
          <h2>Escolhas técnicas atuais e processos confiáveis para entregar com velocidade e manter a qualidade.</h2>
          <p>
            Escolhemos a tecnologia conforme o contexto do projeto, com foco em manutenção, desempenho, segurança e rastreabilidade. A IA é aplicada com critério, sempre a serviço de um objetivo claro.
          </p>
        </div>

        <div class="tag-panel">
          {stack.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-panel">
        <div>
          <p class="kicker">Vamos conversar</p>
          <h2>Se você quer tirar uma ideia do papel, evoluir um produto ou simplificar uma operação, vamos entender o próximo passo juntos.</h2>
        </div>

        <div class="cta-actions">
          <a href="/contato" class="button button-primary">Falar sobre meu projeto</a>
          <a href="mailto:contato@impressione.me" class="button button-secondary">contato@impressione.me</a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
